# --- Supabase ----------------------------------------------------------------
# Migraciones y documentación del backend: se gestionan fuera del repo.
/supabase

# --- Secretos y configuración local ------------------------------------------
# Las credenciales de Supabase no se versionan: en CI las genera scripts/set-env.mjs
# a partir de los secrets. Para trabajar en local, copia environment.example.ts.
/src/environments/environment.ts

.env
.env.*
!.env.example
*.local
*.pem
*.key
*.p12
*.keystore
secrets.json

